# Personal settings. Copy to .env (not committed) and fill in:
#   cp .env.example .env

# pt-BR, pt-PT, en-GB, en-US (full support) or another code such as es, fr, de
JARVIS_LANGUAGE=pt-BR

JARVIS_OWNER_NAME=
JARVIS_OWNER_GENDER=neutral         # female | male | neutral
# Empty = language default (madam/sir, senhora/senhor)
JARVIS_OWNER_TITLE=

# "City, State, Country" - used for weather and timezone
JARVIS_CITY=
# Optional: exact coordinates skip the city lookup
# JARVIS_LATITUDE=51.51
# JARVIS_LONGITUDE=-0.13
# JARVIS_TIMEZONE=Europe/London

# Advanced: any config.yaml key, nested with "__"
# JARVIS_LOG_LEVEL=DEBUG
# JARVIS_LLM__MODEL=qwen3:8b
# JARVIS_TTS__VOICE=pt_BR-faber-medium
# JARVIS_AUDIO__BARGE_IN=true       # interrupt by speaking (use headphones)
